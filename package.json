{
  "name": "opencellar",
  "version": "0.1.0",
  "private": true,
  "description": "An open-source, self-hostable, agent-first wine cellar manager.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p convex/tsconfig.json",
    "test": "vitest run",
    "check:comments": "node scripts/check-no-comments.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm check:comments",
    "smoke:mcp": "node scripts/smoke-mcp.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sandwichlegend/opencellar.git"
  },
  "dependencies": {
    "ai": "^7.0.165",
    "convex": "^1.49.0",
    "convex-helpers": "^0.1.134",
    "eve": "1.0.0-rc.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@types/node": "^26.6.6",
    "convex-test": "^0.0.67",
    "typescript": "^5.9.3",
    "vite": "8.3.6",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "esbuild@0.27.0": true
  },
  "packageManager": "pnpm@12.15.0"
}
